# -----------------------------------------------------------------------------
# Romeoville Archive - environment template
# Copy this file to `.env.local` for development or configure the same keys in
# the Vercel project settings (Project -> Settings -> Environment Variables).
# NEVER commit the real values.
# -----------------------------------------------------------------------------

# --- Database (TiDB Cloud, MySQL compatible) --------------------------------
# Example: mysql://<user>:<password>@<host>:4000/romeoville_records?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# --- Application -----------------------------------------------------------
# Fully qualified base URL used to build every absolute link in emails.
# No trailing slash. Example: https://records.romeovilleproperties.com
APP_BASE_URL=http://localhost:3000

# Secret used to sign/encrypt nothing on its own but to guard bootstrap
# operations. Any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BOOTSTRAP_SECRET=

# --- Mailjet ---------------------------------------------------------------
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=indenturerecords@gmail.com
MAILJET_FROM_NAME=Romeoville Archive

# --- Initial super administrator -------------------------------------------
# Email that receives the very first activation email. This address is granted
# the super administrator role only after it successfully activates.
INITIAL_SUPER_ADMIN_EMAIL=indenturerecords@gmail.com

# --- Limits / tuning (all optional) ----------------------------------------
# Maximum spreadsheet upload size in megabytes.
MAX_UPLOAD_MB=20
# Maximum number of data rows accepted per import.
MAX_IMPORT_ROWS=20000
